include "Schema.fbs";

namespace cudf.io.parquet.flatbuf;

/// ----------------------------------------------------------------------
/// Arrow File metadata
///

table Footer {
  version: cudf.io.parquet.flatbuf.MetadataVersion;

  schema: cudf.io.parquet.flatbuf.Schema;

  dictionaries: [ Block ];

  recordBatches: [ Block ];

  /// User-defined metadata
  custom_metadata: [ KeyValue ];
}

struct Block {

  /// Index to the start of the RecordBatch (note this is past the Message header)
  offset: long;

  /// Length of the metadata
  metaDataLength: int;

  /// Length of the data (this is aligned so there can be a gap between this and
  /// the metadata).
  bodyLength: long;
}

root_type Footer;
